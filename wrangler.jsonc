{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-map",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; everything else is served as a static asset.
    "run_worker_first": ["/api/*"]
  }
}
